{
  "description": "Starter stats for every character, tower and base, one of each per type (requirements §3.2). Drafted placeholders for playtesting. Ids are kind.type and are what commands and records refer to.",
  "stats": {
    "id": {
      "description": "Unique id used by commands and match records. Renaming it breaks old records."
    },
    "kind": {
      "description": "Character, Tower or Base."
    },
    "type": {
      "description": "One of the ten types in type-chart.json."
    },
    "deployCost": {
      "description": "Budget points to deploy. Bases must be 0 (bases are free)."
    },
    "maxHealth": {
      "description": "HP for characters and bases; durability for towers (one bar for firing and damage, D6). At least 1. Every character and tower starts at 100 and every base at 600 (D101); toughness differences live in damageTakenPercent."
    },
    "attack": {
      "description": "Damage before multipliers. Support units use it as heal or repair strength. Bases have 0."
    },
    "defense": {
      "description": "Subtracted from incoming damage (§2.6)."
    },
    "range": {
      "description": "Spaces the unit can reach. 0 means its own space (D24)."
    },
    "damageTakenPercent": {
      "description": "Toughness: percent of incoming damage the unit actually loses, after Defense and Defend (hits, Poison and reflected damage; rounded half up, minimum 1). 100 = normal, below 100 = tougher (Earth 63), above 100 = fragile (Fire 114). D101 set it to 2500 / the old max health, so equal health kept each unit's hits-to-down."
    },
    "fireCost": {
      "description": "Towers only: durability a tower spends each time it fires (D6, D44). A shot can break the tower."
    }
  },
